<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root"
      fx:controller="ni.edu.uam.facturacionapp.Controller.ProductoController"
      prefWidth="1100"
      prefHeight="800"
      spacing="16"
      styleClass="page"
      stylesheets="@styles.css">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="CATÁLOGOS / PRODUCTOS" styleClass="eyebrow"/>
            <Label text="Productos" styleClass="title"/>
        </VBox>
        <Button text="Actualizar tabla" onAction="#actualizar"/>
    </HBox>

    <Label text="Crea un producto o selecciona una fila para editarlo. Los campos con * son obligatorios."
           styleClass="muted" wrapText="true"/>

    <VBox spacing="16" styleClass="card">
        <Label text="Datos del producto" styleClass="card-title"/>

        <GridPane hgap="20" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.34"/>
            </columnConstraints>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Código *"/>
                <TextField fx:id="codigo" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Nombre *"/>
                <TextField fx:id="nombre" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label text="Categoría *"/>
                <ComboBox fx:id="categoria" maxWidth="Infinity"
                          promptText="Selecciona una categoría"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Precio de venta *"/>
                <TextField fx:id="precioVenta" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Existencia *"/>
                <TextField fx:id="existencia" maxWidth="Infinity"/>
            </VBox>

            <CheckBox fx:id="activo"
                      text="Producto activo"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="1"/>
        </GridPane>

        <HBox spacing="10">
            <Button text="Guardar cambios" onAction="#guardar" styleClass="primary"/>
            <Button text="Nuevo / Limpiar" onAction="#nuevo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="eliminarBoton"
                    text="Eliminar seleccionado"
                    onAction="#eliminar"
                    styleClass="danger"/>
        </HBox>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="filtro"
                   HBox.hgrow="ALWAYS"
                   promptText="Buscar por código, nombre o categoría…"/>

        <ComboBox fx:id="filtroEstado" prefWidth="130"/>

        <ComboBox fx:id="filtroCategoria" prefWidth="190"/>

        <Button text="Limpiar filtros" onAction="#limpiarBusqueda"/>
    </HBox>

    <Label text="Los filtros de texto, estado y categoría funcionan simultáneamente."
           styleClass="muted"/>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" prefHeight="290">
        <columns>
            <TableColumn text="Código" prefWidth="130"/>
            <TableColumn text="Nombre" prefWidth="270"/>
            <TableColumn text="Categoría" prefWidth="190"/>
            <TableColumn text="Precio" prefWidth="120"/>
            <TableColumn text="Existencia" prefWidth="120"/>
            <TableColumn text="Activo" prefWidth="110"/>
        </columns>
    </TableView>

    <Label fx:id="estado"
           wrapText="true"
           styleClass="status"
           maxWidth="Infinity"/>
</VBox>
